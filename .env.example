# ---- Required ----

# Encrypts everyone's settings into their link. 32+ characters; make one with: openssl rand -hex 32
# Keep it (and back it up): changing or losing it breaks every link people have made.
CONFIG_SECRET=

# This addon's address as AIOStreams and players reach it, no trailing slash. Links and
# subtitle download URLs are built on it. Example: https://subs.example.com
PUBLIC_BASE_URL=

# ---- Your AIOStreams (recommended) ----

# Your own AIOStreams' public address: install URLs from it are accepted for sync.
# OWN_AIOSTREAMS=https://aiostreams.example.com
# Where this container reaches it, if not at that address (for example on the same Docker network).
# Defaults to OWN_AIOSTREAMS.
# AIOSTREAMS_BASE=http://aiostreams:3000
# The other AIOStreams instances whose install URLs are accepted, comma-separated. Defaults to the
# public instances from the community Jellyfin guide. Set it to your own to accept only that one.
# ALLOWED_AIOSTREAMS=https://aiostreams.example.com

# ---- Who can open the pages ----
# Each opens a sign-in page that keeps you signed in for 30 days. The addon paths never ask for one.

# Required, 8+ characters. Signs in to /stats, the dashboard: usage, API limits and what was played.
# Keep it to yourself.
ADMIN_PASSWORD=
# Optional. Asked for on /configure, where people make and edit their links; give it to the friends
# you add. Unset means anyone who can reach /configure can make a link (fine behind a proxy login).
# ADDON_PASSWORD=

# ---- Optional ----

# The clock the dashboard shows times on (an IANA name such as Europe/London). Default UTC.
# TIME_ZONE=UTC
# Most GB read from the files being played in a day (UTC), over everyone; syncing new files waits
# for the next day once it's spent. Default 50; 0 for no limit.
# DAILY_READ_GB=50
# How long subtitle search results are kept, in seconds (default 6 hours).
# RESULT_CACHE_TTL_SECONDS=21600
# PORT=7000
