{
  "name": "aiosubtitles",
  "version": "1.4.0",
  "description": "Self-hosted Stremio subtitle addon for AIOStreams: English dub captions and other languages, synced to the file being played.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "replay": "tsx scripts/replay.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "keywords": [
    "stremio",
    "subtitles",
    "subsource",
    "dubtitles",
    "sync",
    "aiostreams"
  ],
  "license": "AGPL-3.0-only",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "onnxruntime-web": "1.30.0",
    "xz-decompress": "0.2.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "private": true
}
